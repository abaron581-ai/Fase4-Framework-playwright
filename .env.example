# Copie este archivo como .env y reemplace los valores localmente.
# No confirme el archivo .env ni credenciales reales en Git.
ORANGEHRM_URL=https://opensource-demo.orangehrmlive.com/
ORANGEHRM_USER=usuario_de_prueba
ORANGEHRM_PASSWORD=clave_de_prueba

# Opcional. El valor predeterminado es chrome.
PW_BROWSER_CHANNEL=chrome
