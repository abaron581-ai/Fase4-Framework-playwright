{
  "name": "framework-qa-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Prototipo académico de automatización E2E con Playwright, TypeScript y Page Object Model.",
  "scripts": {
    "test": "playwright test --grep @e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:login": "playwright test tests/orangehrm/login.spec.ts",
    "test:pim": "playwright test tests/orangehrm/pim.spec.ts",
    "test:headed": "playwright test --grep @e2e --headed",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "qa",
    "typescript",
    "page-object-model"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1"
  }
}
